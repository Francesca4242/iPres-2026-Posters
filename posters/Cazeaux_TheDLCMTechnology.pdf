         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">iPRES2026-DLCM-Poster</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">The DLCM Technology&#xD;&#xA;The OAIS-compliant DLCM technology, developed in Switzerland offers an open and modular architecture for the long-term preservation of research or administrative data. The technology provides services based on independent information packages, such as data submission, storage (even in DNA), metadata indexing, and access control via RESTful APIs. It complies with best archiving practices and FAIR principles, while guaranteeing secure access to archives according to data sensitivity.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Hugues CAZEAUX</rdf:li>
               <rdf:li>Pierre-Yves BURGI</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>OAIS</rdf:li>
               <rdf:li>Long-Term preservation</rdf:li>
               <rdf:li>Digital preservation</rdf:li>
               <rdf:li>Archiving solution</rdf:li>
               <rdf:li>Software</rdf:li>
            </rdf:Bag>
         </dc:subject>
